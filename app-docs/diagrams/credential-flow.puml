@startuml
title Credential And Authentication Flow

skinparam backgroundColor #FBFDFF
skinparam shadowing false
skinparam roundcorner 14
skinparam componentStyle rectangle
skinparam defaultFontName "Arial"
skinparam defaultTextAlignment center
skinparam ArrowColor #273746
skinparam packageBorderColor #9FB2C8
skinparam packageBackgroundColor #F7FAFE
skinparam component {
  BackgroundColor #FFFFFF
  BorderColor #34495E
  FontColor #17202A
}
skinparam component<<Security>> {
  BackgroundColor #FFF4E6
  BorderColor #D97904
}
skinparam component<<Storage>> {
  BackgroundColor #EAF7EF
  BorderColor #2E8B57
}
skinparam component<<UI>> {
  BackgroundColor #EAF4FF
  BorderColor #2F74B5
}
skinparam component<<Network>> {
  BackgroundColor #FDEEEF
  BorderColor #B94A48
}

actor "User" as User

package "Encrypted local storage" as Storage #EAF7EF {
  component "Master Password" as Master <<Security>>
  component "credentials.xml" as CredStore <<Storage>>
  component "ssh-keys.xml" as KeyStore <<Storage>>
  component "global-settings.xml" as GlobalSettings <<Storage>>
}

package "Credential usage" as Usage #EAF4FF {
  component "Connection Edit" as ConnEdit <<UI>>
  component "Quick Connect" as QuickConnect <<UI>>
  component "SSH Connection" as SshConnection <<Network>>
}

cloud "Remote Server" as Server <<Network>>

User --> Master
Master --> CredStore
Master --> KeyStore
Master --> GlobalSettings
ConnEdit --> CredStore
ConnEdit --> KeyStore
QuickConnect --> CredStore
QuickConnect --> KeyStore
CredStore --> SshConnection
KeyStore --> SshConnection
SshConnection --> Server

note bottom of Storage
  Secrets remain local and encrypted.
  Connections consume decrypted values only when needed.
end note
@enduml
