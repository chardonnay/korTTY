# Gradle
.gradle/
build/
!gradle/wrapper/gradle-wrapper.jar

# TestNG's own report directory. Gradle writes its reports under build/, but a
# TestNG suite run directly (org.testng.TestNG on the command line, e.g. the
# javac + TestNG loop used to iterate on a single test class) drops this in the
# repository root instead.
test-output/

# IDE
.idea/
*.iml
.vscode/
*.swp

# Claude Code local (machine-specific) settings
.claude/settings.local.json

# Codex/AI agent local configuration
.agents/

# OS
.DS_Store
Thumbs.db

# Python bytecode cache (scripts/ tooling)
__pycache__/
*.py[cod]

# Temporary venv for icon generation
.venv-icon/

# Temporary venvs for translation / documentation tooling. No trailing slash on
# .venv-docs: a worktree borrows it as a symlink from the main checkout, and a
# slash-terminated pattern matches directories only, so the link slipped through.
.venv_translate/
.venv-docs

# Documentation incremental-translation cache
app-docs/site/.docs-translate-cache

# Diagrams/screenshots are copied into the MkDocs tree at build time from the
# canonical app-docs/diagrams and app-docs/screenshots — don't track the copies.
app-docs/site/docs/*/assets/diagrams/
app-docs/site/docs/*/assets/screenshots/

# docs/de is generated from docs/en (scripts/translate_docs.py): only the
# translated *.md are committed; its assets are staged by build-docs-site.py.
app-docs/site/docs/de/assets/

# SithTermFX source (cloned at build time, not a submodule)
vendor/sithtermfx/

# KorTTY user data (optional - uncomment to ignore)
# .kortty/
