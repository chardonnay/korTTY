# Gradle
.gradle/
build/
!gradle/wrapper/gradle-wrapper.jar

# IDE
.idea/
*.iml
.vscode/
*.swp

# Claude Code local (machine-specific) settings
.claude/settings.local.json

# OS
.DS_Store
Thumbs.db

# Python bytecode cache (scripts/ tooling)
__pycache__/
*.py[cod]

# Temporary venv for icon generation
.venv-icon/

# Temporary venvs for translation / documentation tooling
.venv_translate/
.venv-docs/

# Documentation incremental-translation cache
app-docs/site/.docs-translate-cache

# Diagrams/screenshots are copied into the MkDocs tree at build time from the
# canonical app-docs/diagrams and app-docs/screenshots — don't track the copies.
app-docs/site/docs/*/assets/diagrams/
app-docs/site/docs/*/assets/screenshots/

# docs/de is generated from docs/en (scripts/translate_docs.py): only the
# translated *.md are committed; its assets are staged by build-docs-site.py.
app-docs/site/docs/de/assets/

# SithTermFX source (cloned at build time, not a submodule)
vendor/sithtermfx/

# KorTTY user data (optional - uncomment to ignore)
# .kortty/
