   "verified_version": "1.5.47",
   "mode": "live",
   "files": {
    "lmstudio.yaml": "name: LM Studio (LAN)\nversion: 1.0.0\nschema: v1\nmodels:\n  - name: lmstudio\n    provider: openai\n    model: {model}\n    apiBase: {base_url}/\n    apiKey: lm-studio\n    roles:\n      - chat\n      - edit\n      - apply\n"
   },
