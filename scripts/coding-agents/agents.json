{
 "comment": "Coding agents checked by scripts/coding-agents/check.py. mode 'live' drives a real session against an OpenAI-compatible endpoint ({base_url}, no vendor account); mode 'smoke' only starts the agent (account-bound agents, or agents without an account here) and records its first screens without sending a prompt. verified_version is the version the bundled rules (src/main/resources/coding-agents/<kind>.json) were last checked against; the routine updates it after a successful re-check. Placeholders: {home} throwaway home dir, {work} empty working dir, {base_url} e.g. http://host:1234/v1, {base_host} the same without /v1, {model} the model id. Keys are Python string escapes.",
 "agents": [
  {
   "kind": "CODEX",
   "id": "codex",
   "bin": "codex",
   "version_cmd": [
    "codex",
    "--version"
   ],
   "verified_version": "codex-cli 0.162.0",
   "mode": "live",
   "files": {
    "config.toml": "model = \"{model}\"\nmodel_provider = \"lan-lmstudio\"\napproval_policy = \"on-request\"\nsandbox_mode = \"read-only\"\n\n[model_providers.lan-lmstudio]\nname = \"LM Studio (LAN)\"\nbase_url = \"{base_url}\"\nwire_api = \"responses\"\nrequires_openai_auth = false\n\n[analytics]\nenabled = false\n"
   },
   "env": {
    "CODEX_HOME": "{home}"
   },
   "args": [],
   "prompt": "Create a file hello.txt containing hi using a shell command (echo hi > hello.txt).",
   "deny_keys": [
    "\\x1b"
   ],
   "cleanup_pkill": "codex app-server"
  },
  {
   "kind": "QWEN_CODE",
   "id": "qwen-code",
   "bin": "qwen",
   "version_cmd": [
    "qwen",
    "--version"
   ],
   "verified_version": "0.25.0",
   "mode": "live",
   "files": {
    ".qwen/settings.json": "{\"ui\":{\"autoModeAcknowledged\":true},\"security\":{\"auth\":{\"selectedType\":\"openai\"}},\"$version\":4}\n"
   },
   "env": {
    "HOME": "{home}"
   },
   "args": [
    "--openai-base-url",
    "{base_url}",
    "--openai-api-key",
    "lm-studio",
    "-m",
    "{model}",
    "--approval-mode",
    "default"
   ],
   "prompt": "Run this shell command now with your shell tool, do not ask me first: curl -sI https://example.com",
   "deny_keys": [
    "\\x1b"
   ]
  },
  {
   "kind": "OPENCODE",
   "id": "opencode",
   "bin": "opencode",
   "version_cmd": [
    "opencode",
    "--version"
   ],
   "verified_version": "opencode v2.0.25",
   "mode": "live",
   "files": {
    ".config/opencode/opencode.json": "{\"$schema\":\"https://opencode.ai/config.json\",\"autoupdate\":false,\"share\":\"disabled\",\"provider\":{\"lmstudio\":{\"npm\":\"@ai-sdk/openai-compatible\",\"name\":\"LM Studio (LAN)\",\"options\":{\"baseURL\":\"{base_url}\"},\"models\":{\"{model}\":{\"name\":\"{model}\"}}}},\"model\":\"lmstudio/{model}\",\"permission\":{\"edit\":\"ask\",\"bash\":\"ask\",\"webfetch\":\"ask\"}}\n"
   },
   "env": {
    "HOME": "{home}",
    "XDG_CONFIG_HOME": "{home}/.config",
    "XDG_DATA_HOME": "{home}/.local/share",
    "XDG_STATE_HOME": "{home}/.local/state",
    "XDG_CACHE_HOME": "{home}/.cache"
   },
   "args": [
    "--standalone"
   ],
   "cleanup_pkill": "opencode serve",
   "prompt": "Use your bash tool to run exactly: curl -sI https://example.com",
   "deny_keys": [
    "\\x1b[C",
    "\\x1b[C",
    "\\r"
   ]
  },
  {
   "kind": "AIDER",
   "id": "aider",
   "bin": "aider",
   "version_cmd": [
    "aider",
    "--version"
   ],
   "verified_version": "aider 0.86.2",
   "mode": "live",
   "env": {
    "HOME": "{home}"
   },
   "args": [
    "--openai-api-base",
    "{base_url}",
    "--openai-api-key",
    "lm-studio",
