    ".config/crush/crush.json": "{\"$schema\":\"https://charm.land/crush.json\",\"providers\":{\"lmstudio\":{\"name\":\"LM Studio (LAN)\",\"type\":\"openai-compat\",\"base_url\":\"{base_url}/\",\"api_key\":\"lm-studio\",\"models\":[{\"id\":\"{model}\",\"name\":\"{model}\",\"context_window\":131072,\"default_max_tokens\":8192}]}},\"models\":{\"large\":{\"model\":\"{model}\",\"provider\":\"lmstudio\"},\"small\":{\"model\":\"{model}\",\"provider\":\"lmstudio\"}},\"options\":{\"disable_metrics\":true,\"disable_provider_auto_update\":true}}\n"
   },
   "env": {
    "HOME": "{home}",
    "XDG_CONFIG_HOME": "{home}/.config",
    "XDG_DATA_HOME": "{home}/.local/share",
    "XDG_STATE_HOME": "{home}/.local/state",
    "XDG_CACHE_HOME": "{home}/.cache",
    "CRUSH_DISABLE_METRICS": "1"
