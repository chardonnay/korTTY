<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- Tests may deliberately exercise failures. Keep those diagnostics on the Gradle console,
         but never mix them into the real user's ~/.kortty/logs/kortty.log. -->
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <logger name="de.kortty" level="INFO"/>
    <logger name="org.apache.sshd" level="WARN"/>
    <logger name="com.sithtermfx" level="WARN"/>
    <logger name="com.sithtermfx.core.TerminalMode" level="ERROR"/>
    <logger name="com.sithtermfx.core.emulator.SithEmulator" level="ERROR"/>

    <root level="INFO">
        <appender-ref ref="STDOUT"/>
    </root>
</configuration>
