e>.gpg</code>"]},{"s":41940,"e":41943,"k":"block","t":"Tip","f":[]},{"s":41951,"e":42104,"k":"block","t":"If you don't have GPG keys set up yet, use KTPH000Management → Manage GPG Keys...KTPH001 to import keys from your system keyring or add them manually.","f":["<strong>","</strong>"]},{"s":42144,"e":42244,"k":"block","t":"Importing a backupKTPH000","f":["<a class=\"headerlink\" href=\"#importing-a-backup\" title=\"Permanent link\">&para;</a>"]},{"s":42259,"e":42304,"k":"block","t":"Open KTPH000Edit → Import Backup...KTPH001","f":["<strong>","</strong>"]},{"s":42314,"e":42375,"k":"block","t":"Select a backup file (KTPH000 or KTPH001)","f":["<code>.zip</code>","<code>.gpg</code>"]},{"s":42385,"e":42454,"k":"block","t":"If the backup is password-protected, enter the password when prompted","f":[]},{"s":42464,"e":42524,"k":"block","t":"Choose whether to KTPH000Overwrite Existing FilesKTPH001:","f":["<strong>","</strong>"]},{"s":42534,"e":42627,"k":"block","t":"KTPH000CheckedKTPH001 — Backup files will replace any existing files in your configuration","f":["<strong>","</strong>"]},{"s":42637,"e":42725,"k":"block","t":"KTPH000UncheckedKTPH001 — Existing files are skipped; only missing files are imported","f":["<strong>","</strong>"]},{"s":42735,"e":42764,"k":"block","t":"Click KTPH000ImportKTPH001","f":["<strong>","</strong>"]},{"s":42774,"e":42845,"k":"block","t":"KTPH000Restart the applicationKTPH001 for all changes to take effect","f":["<strong>","</strong>"]},{"s":42918,"e":42925,"k":"block","t":"Warning","f":[]},{"s":42933,"e":43137,"k":"block","t":"Importing a backup with KTPH000OverwriteKTPH001 enabled will replace your current settings, connections, and credentials. If you are unsure, uncheck this option to merge the backup without overwriting.","f":["<strong>","</strong>"]},{"s":43179,"e":43283,"k":"block","t":"Backup file contentsKTPH000","f":["<a class=\"headerlink\" href=\"#backup-file-contents\" title=\"Permanent link\">&para;</a>"]},{"s":43292,"e":43368,"k":"block","t":"Both KTPH000 and KTPH001 backups contain the same files:","f":["<code>.zip</code>","<code>.gpg</code>"]},{"s":43382,"e":43443,"k":"block","t":"KTPH000 — All SSH connections and groups","f":["<code>connections.xml</code>"]},{"s":43453,"e":43546,"k":"block","t":"KTPH000 — Stored credentials (still encrypted with your master password)","f":["<code>credentials.xml</code>"]},{"s":43556,"e":43628,"k":"block","t":"KTPH000 — SSH key references and encrypted passphrases","f":["<code>ssh-keys.xml</code>"]},{"s":43638,"e":43836,"k":"block","t":"KTPH000 — Trusted public host keys for interactive Terminal, SFTP, and Mosh bootstrap connections (KTPH001 is intentionally excluded)","f":["<code>ssh-host-keys.properties</code>","<code>ssh-host-keys.properties.lock</code>"]},{"s":43846,"e":43889,"k":"block","t":"KTPH000 — GPG public keys","f":["<code>gpg-keys.xml</code>"]},{"s":43899,"e":43994,"k":"block","t":"KTPH000 — Application settings, themes, AI profiles, terminal defaults","f":["<code>global-settings.xml</code>"]},{"s":44004,"e":44095,"k":"block","t":"KTPH000 — JobScheduler jobs, host-key pins, encrypted sudo passwords","f":["<code>job-scheduler.xml</code>"]},{"s":44105,"e":44160,"k":"block","t":"KTPH000 — Code snippets and templates","f":["<code>snippets.xml</code>"]},{"s":44170,"e":44231,"k":"block","t":"KTPH000 — Custom snippet variables","f":["<code>snippet-variables.xml</code>"]},{"s":44241,"e":44291,"k":"block","t":"KTPH000 — Saved AI conversations","f":["<code>ai-chats.xml</code>"]},{"s":44301,"e":44394,"k":"block","t":"KTPH000 — Hash of your master password (for verification on import)","f":["<code>master-password-hash</code>"]},{"s":44404,"e":44512,"k":"block","t":"KTPH000 — Local GGUF registrations and runtime settings (model weights are not included)","f":["<code>llm/models.xml</code>"]},{"s":44522,"e":44629,"k":"block","t":"KTPH000 — Knowledge-store and source configuration (vector snapshots are not included)","f":["<code>rag/stores.json</code>"]},{"s":44639,"e":44720,"k":"block","t":"KTPH000 — All saved project workspace files (KTPH001)","f":["<code>projects/</code>","<code>.kortty</code>"]},{"s":44790,"e":44794,"k":"block","t":"Note","f":[]},{"s":44802,"e":44994,"k":"block","t":"All passwords and credentials inside the backup remain encrypted with your master password. When you import a backup, you must unlock the master password for KorTTY to decrypt the credentials.","f":[]},{"s":45069,"e":45108,"k":"block","t":"Rebuild local AI assets after a restore","f":[]},{"s":45116,"e":45686,"k":"block","t":"The backup excludes KTPH000, KTPH001, KTPH002, KTPH003, and local KTPH004 snapshots. After moving to another computer, restore or download the GGUF files and a compatible runtime, reconnect any external model/source paths, then run KTPH005Update nowKTPH006 in each knowledge store to regenerate its index. The signed catalog cache refreshes automatically or falls back to the bootstrap. Original source documents and external Qdrant data are not part of a korTTY configuration backup.","f":["<code>llm/models/</code>","<code>llm/runtime/</code>","<code>llm/catalog/</code>","<code>llm/run/</code>","<code>index.hnsw</code>","<strong>","</strong>"]},{"s":45736,"e":45856,"k":"block","t":"Backup retention and cleanupKTPH000","f":["<a class=\"headerlink\" href=\"#backup-retention-and-cleanup\" title=\"Permanent link\">&para;</a>"]},{"s":45865,"e":45943,"k":"block","t":"When you create a new backup in a directory that already contains one, KorTTY:","f":[]},{"s":45957,"e":46013,"k":"block","t":"Creates the new backup as KTPH000","f":["<code>kortty-backup.zip</code>"]},{"s":46023,"e":46112,"k":"block","t":"Moves the existing backup to KTPH000","f":["<code>old-backups/kortty-backup_&lt;timestamp&gt;.zip</code>"]},{"s":46122,"e":46216,"k":"block","t":"If the number of old backups exceeds KTPH000Maximum BackupsKTPH001, deletes the oldest ones","f":["<strong>","</strong>"]},{"s":46231,"e":46505,"k":"block","t":"To keep unlimited old backups, set KTPH002Maximum BackupsKTPH003 to KTPH000 in KTPH004Settings → BackupKTPH005. To keep only the current backup, set KTPH006Maximum BackupsKTPH007 to KTPH001 (old backups are still rotated but then immediately deleted).","f":["<code>0</code>","<code>1</code>","<strong>","</strong>","<strong>","</strong>","<strong>","</strong>"]},{"s":46549,"e":46671,"k":"block","t":"Using backups across machinesKTPH000","f":["<a class=\"headerlink\" href=\"#using-backups-across-machines\" title=\"Permanent link\">&para;</a>"]},{"s":46686,"e":46737,"k":"block","t":"KTPH000Export your current configuration:KTPH001","f":["<strong>","</strong>"]},{"s":46751,"e":46851,"k":"block","t":"On machine A, open KTPH000Edit → Create Backup...KTPH001 and save to a USB drive or cloud storage","f":["<strong>","</strong>"]},{"s":46870,"e":46908,"k":"block","t":"KTPH000Move the backup file:KTPH001","f":["<strong>","</strong>"]},{"s":46927,"e":46998,"k":"block","t":"Copy KTPH000 (or KTPH001) to machine B","f":["<code>kortty-backup.zip</code>","<code>.gpg</code>"]},{"s":47017,"e":47060,"k":"block","t":"KTPH000Import on the new machine:KTPH001","f":["<strong>","</strong>"]},{"s":47075,"e":47134,"k":"block","t":"On machine B, open KTPH000Edit → Import Backup...KTPH001","f":["<strong>","</strong>"]},{"s":47144,"e":47178,"k":"block","t":"Select the backup file from step 2","f":[]},{"s":47188,"e":47225,"k":"block","t":"Enter the backup password if prompted","f":[]},{"s":47235,"e":47325,"k":"block","t":"Leave KTPH000OverwriteKTPH001 unchecked unless you want to replace existing connections","f":["<strong>","</strong>"]},{"s":47335,"e":47349,"k":"block","t":"Restart KorTTY","f":[]},{"s":47364,"e":47786,"k":"block","t":"All backed-up connections, settings, snippets, saved chats, interactive host-key trust decisions, model registrations, and knowledge-source definitions will be available on machine B. Restored host keys are still matched by normalized host name and port, so a changed key remains blocked after migration. Local model weights, runtime packages, source documents, and HNSW vectors must be restored or regenerated separately.","f":[]},{"s":47816,"e":47910,"k":"block","t":"TroubleshootingKTPH000","f":["<a class=\"headerlink\" href=\"#troubleshooting\" title=\"Permanent link\">&para;</a>"]},{"s":47925,"e":47965,"k":"block","t":"KTPH000\"Backup file not found\"KTPH001","f":["<strong>","</strong>"]},{"s":47975,"e":48060,"k":"block","t":"Verify the file path is correct and the file exists. Check the directory permissions.","f":[]},{"s":48070,"e":48136,"k":"block","t":"KTPH000\"Password required for password-encrypted backup\"KTPH001","f":["<strong>","</strong>"]},{"s":48146,"e":48316,"k":"block","t":"Password-protected backups need the correct password. Verify you are entering the credential password (from KTPH000Settings → BackupKTPH001), not your master password.","f":["<strong>","</strong>"]},{"s":48326,"e":48362,"k":"block","t":"KTPH000\"GPG key not found\"KTPH001","f":["<strong>","</strong>"]},{"s":48372,"e":48510,"k":"block","t":"The GPG key used for encryption is missing. Use KTPH000Management → Manage GPG Keys...KTPH001 to import or add the key, then try again.","f":["<strong>","</strong>"]},{"s":48520,"e":48606,"k":"block","t":"KTPH000\"No password selected for backup encryption\" or \"No GPG key selected\"KTPH001","f":["<strong>","</strong>"]},{"s":48616,"e":48722,"k":"block","t":"Configure a password credential or GPG key in KTPH000Settings → BackupKTPH001 before creating a backup.","f":["<strong>","</strong>"]},{"s":48732,"e":48797,"k":"block","t":"KTPH000Import succeeded but changes did not take effectKTPH001","f":["<strong>","</strong>"]},{"s":48807,"e":48953,"k":"block","t":"Restart KorTTY for imported settings to become active. If you imported credentials, you may also need to unlock the master password after restart.","f":[]},{"s":48963,"e":49015,"k":"block","t":"KTPH000Backup file is larger than expectedKTPH001","f":["<strong>","</strong>"]},{"s":49025,"e":49210,"k":"block","t":"Large backups can occur if you have many saved AI chats or a large projects directory. GGUF weights, llama.cpp runtime packages, and HNSW snapshots are excluded and cannot be the cause.","f":[]},{"s":50095,"e":50110,"k":"text","t":"\n  Back to top\n","f":[]},{"s":50353,"e":50394,"k":"text","t":"MIT-licensed · Developed by Daniel Mengel","f":[]},{"s":50440,"e":50452,"k":"text","t":"\n    korTTY ","f":[]},{"s":50460,"e":50466,"k":"text","t":"v2.8.0","f":[]}]}