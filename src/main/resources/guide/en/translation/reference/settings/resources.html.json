e","f":[]},{"s":32866,"e":32872,"k":"block","t":"Values","f":[]},{"s":32882,"e":32889,"k":"block","t":"Default","f":[]},{"s":32899,"e":32908,"k":"block","t":"Stored as","f":[]},{"s":32946,"e":32963,"k":"block","t":"Resource profile:","f":[]},{"s":32973,"e":32981,"k":"block","t":"dropdown","f":[]},{"s":32991,"e":33014,"k":"block","t":"Balanced, High, Maximum","f":[]},{"s":33024,"e":33032,"k":"block","t":"Balanced","f":[]},{"s":33042,"e":33073,"k":"block","t":"KTPH000","f":["<code>jvmResourceProfile</code>"]},{"s":33121,"e":33201,"k":"block","t":"ProfilesKTPH000","f":["<a class=\"headerlink\" href=\"#profiles\" title=\"Permanent link\">&para;</a>"]},{"s":33232,"e":33239,"k":"block","t":"Profile","f":[]},{"s":33249,"e":33259,"k":"block","t":"Heap limit","f":[]},{"s":33269,"e":33286,"k":"block","t":"Garbage collector","f":[]},{"s":33296,"e":33304,"k":"block","t":"Relaunch","f":[]},{"s":33342,"e":33381,"k":"block","t":"KTPH000BalancedKTPH001 (recommended)","f":["<strong>","</strong>"]},{"s":33391,"e":33401,"k":"block","t":"Fixed 2 GB","f":[]},{"s":33411,"e":33438,"k":"block","t":"G1, with idle memory return","f":[]},{"s":33448,"e":33450,"k":"block","t":"No","f":[]},{"s":33471,"e":33492,"k":"block","t":"KTPH000HighKTPH001","f":["<strong>","</strong>"]},{"s":33502,"e":33522,"k":"block","t":"~50% of physical RAM","f":[]},{"s":33532,"e":33534,"k":"block","t":"G1","f":[]},{"s":33544,"e":33564,"k":"block","t":"Yes, once at startup","f":[]},{"s":33585,"e":33609,"k":"block","t":"KTPH000MaximumKTPH001","f":["<strong>","</strong>"]},{"s":33619,"e":33639,"k":"block","t":"~75% of physical RAM","f":[]},{"s":33649,"e":33680,"k":"block","t":"Z Garbage Collector (low pause)","f":[]},{"s":33690,"e":33710,"k":"block","t":"Yes, once at startup","f":[]},{"s":33743,"e":33860,"k":"block","t":"The Resources tab shows your machine's detected memory and the approximate heap limit each profile would apply on it.","f":[]},{"s":33880,"e":33954,"k":"block","t":"NotesKTPH000","f":["<a class=\"headerlink\" href=\"#notes\" title=\"Permanent link\">&para;</a>"]},{"s":34018,"e":34058,"k":"block","t":"Applies to the packaged application only","f":[]},{"s":34066,"e":34509,"k":"block","t":"This setting is applied by the packaged app (the KTPH000/KTPH001/AppImage build), which briefly relaunches itself once at startup to switch the heap size and garbage collector — the Java runtime cannot change these while running, and editing the signed application bundle would break its signature. When korTTY is started from the plain KTPH002, set JVM options yourself (for example KTPH003) instead.","f":["<code>.dmg</code>","<code>.msi</code>","<code>.jar</code>","<code>-Xmx8g</code>"]},{"s":34579,"e":34607,"k":"block","t":"Takes effect after a restart","f":[]},{"s":34615,"e":34798,"k":"block","t":"Changing the profile takes effect the next time korTTY starts. The Balanced default never relaunches; High and Maximum relaunch once per start, so their cold start is slightly slower.","f":[]},{"s":34871,"e":34913,"k":"block","t":"Leave headroom for the rest of your system","f":[]},{"s":34921,"e":35263,"k":"block","t":"Higher profiles let korTTY reserve much more memory. Terminal and editor rendering (the embedded browser engines) also use memory KTPH000outsideKTPH001 the Java heap, so the Maximum profile deliberately caps the heap at about three quarters of RAM rather than removing the limit entirely — a truly unbounded heap could starve the operating system.","f":["<em>","</em>"]},{"s":36148,"e":36163,"k":"text","t":"\n  Back to top\n","f":[]},{"s":36406,"e":36447,"k":"text","t":"MIT-licensed · Developed by Daniel Mengel","f":[]},{"s":36493,"e":36505,"k":"text","t":"\n    korTTY ","f":[]},{"s":36513,"e":36519,"k":"text","t":"v2.7.0","f":[]}]}