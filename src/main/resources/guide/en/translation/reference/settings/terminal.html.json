:35101,"k":"block","t":"toggle","f":[]},{"s":35122,"e":35124,"k":"block","t":"On","f":[]},{"s":35134,"e":35168,"k":"block","t":"KTPH000","f":["<code>showTerminalScrollbar</code>"]},{"s":35189,"e":35212,"k":"block","t":"Show command timestamps","f":[]},{"s":35222,"e":35228,"k":"block","t":"toggle","f":[]},{"s":35249,"e":35252,"k":"block","t":"Off","f":[]},{"s":35262,"e":35299,"k":"block","t":"KTPH000","f":["<code>commandTimestampsEnabled</code>"]},{"s":35320,"e":35363,"k":"block","t":"Allow drag-and-drop file copy into terminal","f":[]},{"s":35373,"e":35379,"k":"block","t":"toggle","f":[]},{"s":35400,"e":35402,"k":"block","t":"On","f":[]},{"s":35412,"e":35448,"k":"block","t":"KTPH000","f":["<code>terminalDragDropEnabled</code>"]},{"s":35469,"e":35510,"k":"block","t":"Copy selection to clipboard automatically","f":[]},{"s":35520,"e":35526,"k":"block","t":"toggle","f":[]},{"s":35547,"e":35549,"k":"block","t":"On","f":[]},{"s":35559,"e":35599,"k":"block","t":"KTPH000","f":["<code>terminalCopyOnSelectEnabled</code>"]},{"s":35620,"e":35670,"k":"block","t":"Close active terminal windows without confirmation","f":[]},{"s":35680,"e":35686,"k":"block","t":"toggle","f":[]},{"s":35707,"e":35710,"k":"block","t":"Off","f":[]},{"s":35720,"e":35778,"k":"block","t":"KTPH000","f":["<code>closeActiveTerminalWindowsWithoutConfirmation</code>"]},{"s":35799,"e":35820,"k":"block","t":"Enable SSH Keep-Alive","f":[]},{"s":35830,"e":35836,"k":"block","t":"toggle","f":[]},{"s":35857,"e":35859,"k":"block","t":"On","f":[]},{"s":35869,"e":35901,"k":"block","t":"KTPH000","f":["<code>sshKeepAliveEnabled</code>"]},{"s":35922,"e":35941,"k":"block","t":"Interval (seconds):","f":[]},{"s":35951,"e":35957,"k":"block","t":"number","f":[]},{"s":35994,"e":36027,"k":"block","t":"KTPH000","f":["<code>sshKeepAliveInterval</code>"]},{"s":36048,"e":36073,"k":"block","t":"Enable connection retries","f":[]},{"s":36083,"e":36089,"k":"block","t":"toggle","f":[]},{"s":36110,"e":36112,"k":"block","t":"On","f":[]},{"s":36122,"e":36159,"k":"block","t":"KTPH000","f":["<code>connectionRetriesEnabled</code>"]},{"s":36180,"e":36220,"k":"block","t":"Automatically reconnect lost connections","f":[]},{"s":36230,"e":36236,"k":"block","t":"toggle","f":[]},{"s":36257,"e":36259,"k":"block","t":"On","f":[]},{"s":36269,"e":36302,"k":"block","t":"KTPH000","f":["<code>autoReconnectEnabled</code>"]},{"s":36323,"e":36372,"k":"block","t":"Disable host key verification for all connections","f":[]},{"s":36382,"e":36388,"k":"block","t":"toggle","f":[]},{"s":36409,"e":36412,"k":"block","t":"Off","f":[]},{"s":36422,"e":36472,"k":"block","t":"KTPH000","f":["<code>hostKeyCheckDisabledForAllConnections</code>"]},{"s":36517,"e":36591,"k":"block","t":"NotesKTPH000","f":["<a class=\"headerlink\" href=\"#notes\" title=\"Permanent link\">&para;</a>"]},{"s":36655,"e":36665,"k":"block","t":"Scrollback","f":[]},{"s":36673,"e":36957,"k":"block","t":"Controls how many lines of output each terminal pane keeps in its scrollback buffer. The value is read when a terminal is created, so a change applies to newly opened tabs and split panes — already-open terminals keep their current buffer size. Larger values use more memory per pane.","f":[]},{"s":37027,"e":37041,"k":"block","t":"SSH Keep-Alive","f":[]},{"s":37049,"e":37336,"k":"block","t":"When enabled, korTTY sends periodic keep-alive packets to prevent SSH sessions from timing out during idle periods. The interval setting controls how often (in seconds) these packets are sent. The spinner range is 5–600 seconds; the interval is disabled if SSH Keep-Alive is toggled off.","f":[]},{"s":37409,"e":37458,"k":"block","t":"Disable host key verification for all connections","f":[]},{"s":37466,"e":38083,"k":"block","t":"This is the global, lowest-precedence host-key setting: it relaxes verification to accept-new for every connection that does not set its own or its group's override. Accept-new still hard-blocks a changed key on a host already pinned, and a jump server's own key is always verified strictly — but disabling first-use verification removes protection against a man-in-the-middle on the very first connection. Off by default. Per-connection and per-group overrides are set in the Connection Manager; see KTPH000Security → Relaxing host-key verificationKTPH001.","f":["<a href=\"../../features/security.html#relaxing-host-key-verification\">","</a>"]},{"s":38153,"e":38176,"k":"block","t":"Drag-and-Drop File Copy","f":[]},{"s":38184,"e":38384,"k":"block","t":"When enabled, you can drop files or folders from your file manager (Finder on macOS, Explorer on Windows) directly into the terminal window. The files will be copied to the remote SSH server via SFTP.","f":[]},{"s":38454,"e":38472,"k":"block","t":"Command Timestamps","f":[]},{"s":38480,"e":38644,"k":"block","t":"When enabled, a sidebar appears on the left side of the terminal displaying the date and time each command was entered, useful for audit trails and session logging.","f":[]},{"s":38714,"e":38732,"k":"block","t":"Connection Retries","f":[]},{"s":38740,"e":38883,"k":"block","t":"When enabled, failed SSH connections are automatically retried. Disabling this prevents automatic reconnection attempts for failed connections.","f":[]},{"s":38891,"e":39102,"k":"block","t":"Retries only cover failures that a further attempt could resolve. A changed host key, a Mosh connection configured with a jump server, or a missing Mosh runtime is refused immediately regardless of this setting.","f":[]},{"s":39172,"e":39212,"k":"block","t":"Automatically reconnect lost connections","f":[]},{"s":39220,"e":39987,"k":"block","t":"When enabled and an KTPH000establishedKTPH001 SSH connection is lost (network drop, server gone), the tab reconnects on its own with increasing delays — 3, 5, 10, 20, 30, then every 60 seconds — and the red status bar counts down to the next attempt. A double-click on the bar still reconnects immediately, and a successful reconnect or closing the tab stops the automatic attempts. Failed logins and other permanent failures (authentication, host key, configuration) are never retried automatically, and a connection that never got established is not retried by this setting either — that is what KTPH002Enable connection retriesKTPH003 covers. See KTPH004Terminal sessions → Connection lossKTPH005.","f":["<strong>","</strong>","<em>","</em>","<a href=\"../../features/terminal.html#connection-loss-and-automatic-reconnect\">","</a>"]},{"s":40872,"e":40887,"k":"text","t":"\n  Back to top\n","f":[]},{"s":41130,"e":41171,"k":"text","t":"MIT-licensed · Developed by Daniel Mengel","f":[]},{"s":41217,"e":41229,"k":"text","t":"\n    korTTY ","f":[]},{"s":41237,"e":41244,"k":"text","t":"v2.13.0","f":[]}]}