<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <property name="KORTTY_LOG_DIR" value="${kortty.log.dir:-${user.home}/.kortty/logs}"/>

    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>
    
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${KORTTY_LOG_DIR}/kortty.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>${KORTTY_LOG_DIR}/kortty.%d{yyyy-MM-dd}.log</fileNamePattern>
            <!-- Enterprise policy rotation caps ([rule.logging]); 0 = unlimited/uncapped. -->
            <maxHistory>${kortty.log.maxHistory:-0}</maxHistory>
            <totalSizeCap>${kortty.log.totalSizeCap:-0}</totalSizeCap>
        </rollingPolicy>
        <!-- Encoder class is selected by the enterprise logging policy ([rule.logging] format):
             the default pattern encoder, or logback's JSON encoder. The <pattern> child is only
             read by the pattern encoder; the JSON encoder ignores it. -->
        <encoder class="${kortty.log.encoderClass:-ch.qos.logback.classic.encoder.PatternLayoutEncoder}">
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>
    
    <logger name="de.kortty" level="INFO"/>
    <logger name="org.apache.sshd" level="WARN"/>
    <logger name="com.sithtermfx" level="WARN"/>
    <!-- Suppress known-harmless SithTermFX warnings: InsertMode not implemented, unhandled ESC[?1001s -->
    <logger name="com.sithtermfx.core.TerminalMode" level="ERROR"/>
    <logger name="com.sithtermfx.core.emulator.SithEmulator" level="ERROR"/>
    
    <root level="INFO">
        <appender-ref ref="STDOUT"/>
        <appender-ref ref="FILE"/>
    </root>
</configuration>
