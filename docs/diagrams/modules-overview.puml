@startuml
title KorTTY Module Overview
top to bottom direction

skinparam backgroundColor #FBFDFF
skinparam shadowing false
skinparam roundcorner 14
skinparam componentStyle rectangle
skinparam defaultFontName "Arial"
skinparam defaultTextAlignment center
skinparam ArrowColor #273746
skinparam packageBorderColor #9FB2C8
skinparam packageBackgroundColor #F7FAFE
skinparam component {
  BorderColor #34495E
  BackgroundColor #FFFFFF
  FontColor #17202A
}
skinparam component<<App>> {
  BackgroundColor #EAF4FF
  BorderColor #2F74B5
}
skinparam component<<Terminal>> {
  BackgroundColor #F2ECFF
  BorderColor #7E57C2
}
skinparam component<<Data>> {
  BackgroundColor #EAF7EF
  BorderColor #2E8B57
}
skinparam component<<Security>> {
  BackgroundColor #FFF4E6
  BorderColor #D97904
}
skinparam component<<Optional>> {
  BackgroundColor #FDEEEF
  BorderColor #B94A48
}

component "KorTTY\n de.kortty" as KorTTY <<App>>

package "Java Platform" #EAF4FF {
  component "JavaFX 21\ncontrols, fxml, graphics, swing" as JavaFx <<App>>
}

package "SSH & Crypto" #FFF4E6 {
  component "Apache SSHD 2.12\ncore, common, sftp" as Sshd <<Security>>
  component "Ed25519\nnet.i2p.crypto:eddsa" as Ed25519 <<Security>>
}

package "Terminal" #F2ECFF {
  component "SithTermFX 1.1\ncore, ui" as SithTerm <<Terminal>>
  component "Lanterna 3.1" as Lanterna <<Terminal>>
  component "pty4j 0.12" as Pty4j <<Terminal>>
}

package "Data & Serialization" #EAF7EF {
  component "JAXB 4\njakarta.xml.bind" as Jaxb <<Data>>
  component "zip4j 2.11" as Zip4j <<Data>>
  component "Gson 2.13" as Gson <<Data>>
  component "PDFBox 3" as PdfBox <<Data>>
}

package "Utilities" #F7FAFE {
  component "RichTextFX 0.11" as RichText <<App>>
  component "jfiglet 0.0.9" as JFiglet <<App>>
  component "zxcvbn 1.9" as Zxcvbn <<Security>>
  component "SLF4J 2.0\nLogback 1.4" as Logging <<App>>
}

package "Optional runtime" #FDEEEF {
  component "mosh4j 2.0\nprotocol, crypto,\ntransport, terminal, core" as Mosh4j <<Optional>>
}

KorTTY --> JavaFx
KorTTY --> Sshd
Sshd --> Ed25519
KorTTY --> SithTerm
SithTerm --> Lanterna
KorTTY --> Pty4j
KorTTY --> Jaxb
KorTTY --> Zip4j
KorTTY --> Gson
KorTTY --> PdfBox
KorTTY --> RichText
KorTTY --> JFiglet
KorTTY --> Zxcvbn
KorTTY --> Logging
KorTTY ..> Mosh4j : optional Mosh support
@enduml
