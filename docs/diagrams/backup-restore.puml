@startuml
title Backup And Restore Flow

skinparam backgroundColor #FBFDFF
skinparam shadowing false
skinparam roundcorner 14
skinparam defaultFontName "Arial"
skinparam ArrowColor #273746
skinparam activity {
  BackgroundColor #FFFFFF
  BorderColor #34495E
  FontColor #17202A
  DiamondBackgroundColor #FFF4E6
  DiamondBorderColor #D97904
  StartColor #2E8B57
  EndColor #2E8B57
}
skinparam partition {
  BackgroundColor #F7FAFE
  BorderColor #9FB2C8
}

start
partition "Create Backup" #EAF4FF {
  :User opens\nEdit > Create Backup;
  :Select destination directory;
  if (Encryption mode?) then (Password)
    :Create encrypted\n.zip backup;
  else (GPG)
    :Create encrypted\n.gpg backup;
  endif
}

:Backup file is stored\noutside KorTTY config;

partition "Import Backup" #EAF7EF {
  :User opens\nEdit > Import Backup;
  :Select .zip or .gpg file;
  :Decrypt backup;
  :Restore connections,\ncredentials and settings;
  :Settings restored;
}
stop

legend right
  Backup export and import are separate user-driven flows.
  Encrypted payloads carry the reusable configuration state.
endlegend
@enduml
