@startuml
title Terminal Session Lifecycle

skinparam backgroundColor #FBFDFF
skinparam shadowing false
skinparam roundcorner 14
skinparam defaultFontName "Arial"
skinparam ArrowColor #273746
skinparam state {
  BackgroundColor #FFFFFF
  BorderColor #34495E
  FontColor #17202A
  StartColor #2E8B57
  EndColor #2E8B57
}
skinparam state<<Active>> {
  BackgroundColor #EAF7EF
  BorderColor #2E8B57
}
skinparam state<<Error>> {
  BackgroundColor #FDEEEF
  BorderColor #B94A48
}
skinparam state<<UI>> {
  BackgroundColor #EAF4FF
  BorderColor #2F74B5
}

state NewTab <<UI>>
state Connecting <<UI>>
state Connected <<Active>>
state Failed <<Error>>
state SplitOptional <<UI>>
state SinglePane <<Active>>
state Broadcast <<Active>>
state Reconnecting <<UI>>
state EffectActive <<UI>>

[*] --> NewTab : User opens tab
NewTab --> Connecting : Start connection
Connecting --> Connected : Success
Connecting --> Failed : Error
Failed --> Connecting : Retry
Failed --> [*] : Close tab

Connected --> SplitOptional : Optional split
Connected --> SinglePane : Single pane
Connected --> EffectActive : Select terminal effect
SplitOptional --> Broadcast : Enable broadcast
SinglePane --> Connected
SplitOptional --> Connected
Broadcast --> Connected
EffectActive --> Connected : Disable or switch effect

Connected --> Reconnecting : Reconnect requested
EffectActive --> Reconnecting : Reconnect with effect
Reconnecting --> Connecting : Close and reconnect
Connected --> [*] : Close tab
EffectActive --> [*] : Close tab\nstop effect

note right of Connected
  Split panes and broadcast are UI modes
  around the same terminal-session lifecycle.
end note

note right of EffectActive
  Terminal effects are per terminal view.
  They can apply appearance, overlays,
  and connector wrappers.
end note
@enduml
