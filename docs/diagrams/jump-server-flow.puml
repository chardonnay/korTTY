@startuml
title Jump Server Connection Flow

skinparam backgroundColor #FBFDFF
skinparam shadowing false
skinparam roundcorner 14
skinparam componentStyle rectangle
skinparam defaultFontName "Arial"
skinparam defaultTextAlignment center
skinparam ArrowColor #273746
skinparam ArrowThickness 1.4
skinparam component {
  BorderColor #34495E
  BackgroundColor #FFFFFF
  FontColor #17202A
}
skinparam component<<Client>> {
  BackgroundColor #EAF4FF
  BorderColor #2F74B5
}
skinparam component<<Bastion>> {
  BackgroundColor #FFF4E6
  BorderColor #D97904
}
skinparam component<<Target>> {
  BackgroundColor #EAF7EF
  BorderColor #2E8B57
}

component "User PC\nKorTTY" as UserPc <<Client>>
component "Jump Server\nBastion host" as Jump <<Bastion>>
component "Target Server" as Target <<Target>>

UserPc --> Jump : 1. SSH
Jump --> Target : 2. SSH through tunnel
UserPc ..> Jump : all terminal traffic\nenters via bastion
Jump ..> Target : forwarded session

legend right
  The target server is reached through the bastion.
  KorTTY presents the resulting remote terminal stream.
endlegend
@enduml
