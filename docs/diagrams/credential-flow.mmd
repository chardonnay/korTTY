%% Credentials and authentication flow
flowchart LR
    subgraph Storage["Encrypted Storage"]
        Master[Master Password]
        Master --> CredStore[credentials.xml]
        Master --> SSHStore[ssh-keys.xml]
        Master --> Global[global-settings.xml]
    end

    subgraph Use["Usage"]
        ConnEdit[Connection Edit]
        QuickConn[Quick Connect]
        ConnEdit --> CredStore
        ConnEdit --> SSHStore
        QuickConn --> CredStore
        QuickConn --> SSHStore
    end

    User([User]) --> Master
    CredStore --> Conn[SSH Connection]
    SSHStore --> Conn
    Conn --> Server([Remote Server])
