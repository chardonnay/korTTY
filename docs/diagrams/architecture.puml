@startuml
title KorTTY Architecture
top to bottom direction

skinparam backgroundColor #FBFDFF
skinparam shadowing false
skinparam roundcorner 14
skinparam componentStyle rectangle
skinparam defaultFontName "Arial"
skinparam defaultTextAlignment center
skinparam ArrowColor #263544
skinparam ArrowThickness 1.2
skinparam packageBorderColor #9FB2C8
skinparam packageBackgroundColor #F7FAFE
skinparam component {
  BorderColor #34495E
  BackgroundColor #FFFFFF
  FontColor #17202A
}
skinparam component<<UI>> {
  BackgroundColor #EAF4FF
  BorderColor #2F74B5
}
skinparam component<<Workflow>> {
  BackgroundColor #F2ECFF
  BorderColor #7E57C2
}
skinparam component<<Data>> {
  BackgroundColor #EAF7EF
  BorderColor #2E8B57
}
skinparam component<<Security>> {
  BackgroundColor #FFF4E6
  BorderColor #D97904
}

package "KorTTY Application" as App #EAF4FF {
  component "Main Window" as MainWindow <<UI>>
  component "Menu Bar" as MenuBar <<UI>>
  component "Dashboard" as Dashboard <<UI>>
  component "Status Bar" as StatusBar <<UI>>
  component "Tab Bar" as TabBar <<UI>>
  component "Terminal Tabs" as TerminalTabs <<UI>>
  component "SFTP Manager Tabs" as SftpTabs <<UI>>
  component "AI Result Tabs" as AiTabs <<UI>>
}

package "Tools & Workflows" as Workflows #F2ECFF {
  component "Quick Connect" as QuickConnect <<Workflow>>
  component "Connection Manager" as ConnectionManager <<Workflow>>
  component "Open SFTP" as OpenSftp <<Workflow>>
  component "Snippet Manager" as Snippets <<Workflow>>
  component "AI Manager" as AiManager <<Workflow>>
  component "AI Profiles" as AiProfiles <<Workflow>>
  component "Saved Chats" as SavedChatsUi <<Workflow>>
}

database "Configuration & Data" as Data #EAF7EF {
  component "connections.xml" as Connections <<Data>>
  component "credentials.xml" as Credentials <<Security>>
  component "global-settings.xml" as Settings <<Data>>
  component "projects/" as Projects <<Data>>
  component "saved-ai-chats.json" as AiChats <<Data>>
  component "SSH / GPG keys" as Keys <<Security>>
  component "Environments" as Environments <<Data>>
}

MainWindow --> MenuBar
MainWindow --> Dashboard
MainWindow --> TabBar
MainWindow --> StatusBar
TabBar --> TerminalTabs
TabBar --> SftpTabs
TabBar --> AiTabs
MenuBar --> Workflows
ConnectionManager --> Connections
QuickConnect --> Connections
OpenSftp --> SftpTabs
Snippets --> Settings
AiManager --> SavedChatsUi
AiProfiles --> Settings
SavedChatsUi --> AiChats
StatusBar --> Connections
Credentials --> ConnectionManager
Keys --> ConnectionManager
Projects --> Dashboard
Environments --> ConnectionManager
AiTabs --> SavedChatsUi

note right of App
  UI surfaces stay in JavaFX tabs and dialogs.
  Persistent state is kept in local configuration files.
end note
@enduml
