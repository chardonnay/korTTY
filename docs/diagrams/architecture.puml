@startuml
title KorTTY Architecture
top to bottom direction

skinparam backgroundColor #FBFDFF
skinparam shadowing false
skinparam roundcorner 14
skinparam componentStyle rectangle
skinparam defaultFontName "Arial"
skinparam defaultTextAlignment center
skinparam ArrowColor #263544
skinparam ArrowThickness 1.2
skinparam packageBorderColor #9FB2C8
skinparam packageBackgroundColor #F7FAFE
skinparam component {
  BorderColor #34495E
  BackgroundColor #FFFFFF
  FontColor #17202A
}
skinparam component<<UI>> {
  BackgroundColor #EAF4FF
  BorderColor #2F74B5
}
skinparam component<<Workflow>> {
  BackgroundColor #F2ECFF
  BorderColor #7E57C2
}
skinparam component<<Data>> {
  BackgroundColor #EAF7EF
  BorderColor #2E8B57
}
skinparam component<<Security>> {
  BackgroundColor #FFF4E6
  BorderColor #D97904
}

package "KorTTY Application" as App #EAF4FF {
  component "Main Window" as MainWindow <<UI>>
  component "Menu Bar" as MenuBar <<UI>>
  component "Dashboard" as Dashboard <<UI>>
  component "Status Bar" as StatusBar <<UI>>
  component "Tab Bar" as TabBar <<UI>>
  component "Terminal Tabs" as TerminalTabs <<UI>>
  component "SFTP Manager Tabs" as SftpTabs <<UI>>
  component "AI Result Tabs" as AiTabs <<UI>>
  component "JobScheduler Dialog" as JobSchedulerDialog <<UI>>
  component "JobScheduler\nMenu Status" as JobSchedulerStatus <<UI>>
  component "Terminal Effects\nPlugin Dialog" as TerminalEffectDialog <<UI>>
}

package "Tools & Workflows" as Workflows #F2ECFF {
  component "Quick Connect" as QuickConnect <<Workflow>>
  component "Connection Manager" as ConnectionManager <<Workflow>>
  component "Open SFTP" as OpenSftp <<Workflow>>
  component "Snippet Manager" as Snippets <<Workflow>>
  component "JobScheduler Service" as JobScheduler <<Workflow>>
  component "AI Manager" as AiManager <<Workflow>>
  component "AI Profiles" as AiProfiles <<Workflow>>
  component "Saved Chats" as SavedChatsUi <<Workflow>>
  component "Headless SSH/SFTP/Rsync\nExecution" as HeadlessExecution <<Workflow>>
}

package "Terminal Effects" as Effects #FFF7E6 {
  component "TerminalEffectPluginManager" as EffectManager <<Workflow>>
  component "TerminalEffectSession" as EffectSession <<Workflow>>
  component "MOTHER bundled JAR" as MotherJar <<Workflow>>
  component "External plugin JARs" as ExternalJars <<Workflow>>
}

database "Configuration & Data" as Data #EAF7EF {
  component "connections.xml" as Connections <<Data>>
  component "credentials.xml" as Credentials <<Security>>
  component "global-settings.xml" as Settings <<Data>>
  component "job-scheduler.xml" as JobSchedulerData <<Security>>
  component "terminal-effect-plugins.disabled" as EffectDisabled <<Data>>
  component "plugins/ + bundled-plugins/" as EffectJars <<Data>>
  component "projects/" as Projects <<Data>>
  component "saved-ai-chats.json" as AiChats <<Data>>
  component "SSH / GPG keys" as Keys <<Security>>
  component "Environments" as Environments <<Data>>
}

MainWindow --> MenuBar
MainWindow --> Dashboard
MainWindow --> TabBar
MainWindow --> StatusBar
TabBar --> TerminalTabs
TabBar --> SftpTabs
TabBar --> AiTabs
MenuBar --> Workflows
MenuBar --> JobSchedulerStatus
MenuBar --> TerminalEffectDialog
ConnectionManager --> Connections
ConnectionManager --> EffectManager : saved effect id + speed
QuickConnect --> Connections
QuickConnect --> EffectManager : selected effect id + speed
OpenSftp --> SftpTabs
Snippets --> Settings
JobSchedulerDialog --> JobScheduler
JobSchedulerStatus --> JobScheduler
JobScheduler --> Connections
JobScheduler --> Snippets : snippet scripts
JobScheduler --> JobSchedulerData
JobScheduler --> Credentials
JobScheduler --> Keys
JobScheduler --> HeadlessExecution
AiManager --> SavedChatsUi
AiProfiles --> Settings
SavedChatsUi --> AiChats
StatusBar --> Connections
Credentials --> ConnectionManager
Keys --> ConnectionManager
Projects --> Dashboard
Environments --> ConnectionManager
AiTabs --> SavedChatsUi
TerminalEffectDialog --> EffectManager
TerminalTabs --> EffectSession
EffectManager --> MotherJar
EffectManager --> ExternalJars
EffectManager --> EffectDisabled
EffectManager --> EffectJars
EffectSession --> TerminalTabs : appearance, overlay,\nconnector wrapper
MotherJar --> EffectSession
ExternalJars --> EffectSession

note right of App
  UI surfaces stay in JavaFX tabs and dialogs.
  Persistent state is kept in local configuration files.
end note
@enduml
