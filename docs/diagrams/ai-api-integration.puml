@startuml
title KorTTY AI API Integration

skinparam backgroundColor #FBFDFF
skinparam shadowing false
skinparam roundcorner 14
skinparam componentStyle rectangle
skinparam defaultFontName "Arial"
skinparam defaultTextAlignment center
skinparam ArrowColor #2F3A4A
skinparam ArrowThickness 1.2
skinparam packageBorderColor #8AA2C8
skinparam packageBackgroundColor #F6F9FE
skinparam component {
  BorderColor #385070
  BackgroundColor #FFFFFF
  FontColor #1D2733
}

skinparam component<<UI>> {
  BackgroundColor #EAF4FF
  BorderColor #3A7BBF
}
skinparam component<<AI>> {
  BackgroundColor #F2ECFF
  BorderColor #7E57C2
}
skinparam component<<Storage>> {
  BackgroundColor #EAF7EF
  BorderColor #2E8B57
}
skinparam component<<Security>> {
  BackgroundColor #FFF4E6
  BorderColor #D97904
}
skinparam component<<External>> {
  BackgroundColor #FDEEEF
  BorderColor #B94A48
}

package "Terminal workflow" as Workflow #EAF4FF {
  component "Selected terminal text" as Selection <<UI>>
  component "Context menu\nAI actions" as Menu <<UI>>
  component "Confirm dialog\npreview + token estimate" as Confirm <<UI>>
  component "AI Manager\nsaved chats" as Manager <<UI>>
}

package "Local configuration" as Config #EAF7EF {
  component "AI profiles\nmodel + limits" as Profiles <<Storage>>
  component "Token usage\nthresholds + reset cycle" as Quotas <<Storage>>
  component "Encrypted API key\nlocal vault" as Vault <<Security>>
  component "Saved AI chats\nmessages + profile refs" as SavedChats <<Storage>>
}

package "KorTTY AI pipeline" as Pipeline #F2ECFF {
  component "AiPromptBuilder\nsystem + user messages" as Prompt <<AI>>
  component "OpenAI-compatible service\n/chat/completions" as Service <<AI>>
  component "Usage manager\nrecord tokens" as Usage <<AI>>
  component "Response sanitizer\nstrip visible think blocks" as Sanitizer <<AI>>
  component "AI result tab\nfollow-up + export" as Result <<UI>>
  component "Chat manager\nsave + reopen" as ChatManager <<AI>>
  component "Missing-profile dialog\nreplacement profile" as Fallback <<UI>>
}

cloud "OpenAI-compatible endpoint" as Endpoint #FDEEEF {
  component "Cloud API or\nlocal runtime" as API <<External>>
}

Selection --> Menu
Menu --> Confirm
Profiles --> Confirm
Quotas --> Confirm
Vault --> Service
Confirm --> Prompt
Prompt --> Service
Service --> API
API --> Service
Service --> Sanitizer
Sanitizer --> Result
Service --> Usage
Usage --> Result
Result ..> Prompt : follow-up prompt
Result --> ChatManager : save / autosave
ChatManager --> SavedChats
Manager --> ChatManager
SavedChats --> ChatManager
ChatManager --> Result
Profiles ..> Fallback : missing original profile
Fallback --> ChatManager
Profiles ..> Service : selected profile

legend right
  <#F2ECFF> AI pipeline
  <#EAF7EF> Local data
  <#FFF4E6> Secure secrets
  <#FDEEEF> External endpoint
endlegend
@enduml
